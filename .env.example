# Application Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Single Relational Database Configuration (MySQL)
DATABASE_URL="mysql://appuser:apppassword@localhost:3306/aistudyassistant"

# Provider Mode Selection ('mock' or 'azure')
AI_PROVIDER=mock

# Firebase Console Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ai-study-assistant.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ai-study-assistant
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ai-study-assistant.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Microsoft Entra ID Authentication
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Azure AI Foundry & Model Deployments
AZURE_FOUNDRY_ENDPOINT=https://your-foundry-resource.openai.azure.com/
AZURE_FOUNDRY_PROJECT=ai-study-assistant
AZURE_MODEL_DEPLOYMENT=gpt-4o

# Azure AI Search (Vector & Hybrid Search)
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-api-key
AZURE_SEARCH_INDEX=study-documents-index

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=aistudyassistantstorage
AZURE_STORAGE_CONTAINER=study-materials

# Azure Speech Service (STT & TTS)
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-doc-intel-key

# Azure AI Vision
AZURE_VISION_ENDPOINT=https://your-vision.cognitiveservices.azure.com/
AZURE_VISION_KEY=your-vision-key

# AI Safety & Performance Constraints
AI_MAX_TOKENS=2048
AI_MAX_FILE_SIZE=10485760
MAX_SEARCH_RESULTS=10
